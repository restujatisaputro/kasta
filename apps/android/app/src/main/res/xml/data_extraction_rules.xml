<?xml version="1.0" encoding="utf-8"?>
<!--
  android:allowBackup="false" hanya mengatur cloud backup sejak Android 12.
  Transfer antar-perangkat tidak tercakup atribut tersebut, sehingga basis data
  Room berisi transaksi keuangan dan DataStore berisi ID perangkat serta cursor
  sinkronisasi masih dapat ikut berpindah ke perangkat baru. Seluruh domain
  dikecualikan pada kedua jalur agar data usaha tidak pernah meninggalkan
  perangkat lewat backup maupun transfer; data ditarik ulang dari server
  setelah pengguna masuk kembali.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
        <exclude domain="device_root" />
        <exclude domain="device_file" />
        <exclude domain="device_database" />
        <exclude domain="device_sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
        <exclude domain="device_root" />
        <exclude domain="device_file" />
        <exclude domain="device_database" />
        <exclude domain="device_sharedpref" />
    </device-transfer>
</data-extraction-rules>
