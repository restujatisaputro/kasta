    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@tailwindcss/vite": "^4.0.14",
    "@testing-library/svelte": "^5.2.8",
    "@types/node": "^22.13.10",
    "eslint": "^9.22.0",
    "eslint-plugin-svelte": "^3.22.0",
    "globals": "^16.0.0",
    "jsdom": "^26.0.0",
    "svelte": "^5.23.1",
    "svelte-check": "^4.1.5",
    "tailwindcss": "^4.0.14",
