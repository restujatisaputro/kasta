# Copy this file to .env for local Docker Compose development.
# Never store real staging or production secrets in this repository.

COMPOSE_PROJECT_NAME=kasta-platform

# KASTA runtime
KASTA_ENVIRONMENT=local
KASTA_DEBUG=true
KASTA_LOG_LEVEL=INFO
KASTA_LOG_FORMAT=json
KASTA_API_HOST=0.0.0.0
KASTA_API_PORT=8000
KASTA_API_VERSION=v1
KASTA_SITE_ADDRESS=http://localhost:8080
KASTA_OBJECT_ADDRESS=http://localhost:9002

# PostgreSQL
POSTGRES_DB=kasta
POSTGRES_USER=kasta
POSTGRES_PASSWORD=kasta-local-only
KASTA_DB_APP_USER=kasta_app
KASTA_DB_APP_PASSWORD=replace-this-local-runtime-password
KASTA_DATABASE_URL=postgresql+psycopg://kasta:kasta-local-only@localhost:5432/kasta
KASTA_DATABASE_ECHO=false
KASTA_DATABASE_POOL_SIZE=5
KASTA_DATABASE_MAX_OVERFLOW=10

# JSON array; browser origins only, without paths.
KASTA_CORS_ORIGINS=["http://localhost:5173","http://localhost:8080"]
KASTA_CORS_ALLOW_CREDENTIALS=true
KASTA_REQUEST_ID_HEADER=X-Request-ID

# Authentication (development value only)
KASTA_JWT_SIGNING_KEY=replace-this-local-development-key
KASTA_JWT_ALGORITHM=HS256
KASTA_JWT_ISSUER=kasta-api
KASTA_JWT_AUDIENCE=kasta-clients
KASTA_TOKEN_HASH_KEY=replace-this-local-token-hash-key
# Base64 URL-safe 32-byte AES-GCM key; development value only.
KASTA_OUTBOX_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
KASTA_ACCESS_TOKEN_MINUTES=15
KASTA_ONBOARDING_TOKEN_MINUTES=60
KASTA_REFRESH_TOKEN_DAYS=30
KASTA_VERIFICATION_TOKEN_MINUTES=30
KASTA_PASSWORD_RESET_TOKEN_MINUTES=15
KASTA_LOGIN_RATE_WINDOW_SECONDS=300
KASTA_LOGIN_RATE_MAX_ATTEMPTS=5
KASTA_LOGIN_RATE_LOCK_SECONDS=900
KASTA_ACCOUNT_LOCK_MAX_ATTEMPTS=10
KASTA_ACCOUNT_LOCK_SECONDS=1800
KASTA_API_RATE_LIMIT_PER_MINUTE=600
KASTA_SENSITIVE_RATE_LIMIT_PER_MINUTE=30
KASTA_UPLOAD_RATE_LIMIT_PER_MINUTE=20
KASTA_TRUSTED_PROXY_CIDRS=["172.16.0.0/12"]

# MinIO / S3-compatible object storage
MINIO_ROOT_USER=kasta
MINIO_ROOT_PASSWORD=kasta-local-object-storage
KASTA_OBJECT_ENDPOINT=http://localhost:9000
KASTA_OBJECT_PUBLIC_ENDPOINT=http://localhost:9002
KASTA_OBJECT_BUCKET_RECEIPTS=kasta-receipts-local
KASTA_OBJECT_BUCKET_BUSINESS_LOGOS=kasta-business-logos-local
KASTA_OBJECT_ACCESS_KEY=kasta
KASTA_OBJECT_SECRET_KEY=kasta-local-object-storage
KASTA_OBJECT_USE_SSL=false
KASTA_SIGNED_URL_SECONDS=300
KASTA_MALWARE_SCAN_ENABLED=false
KASTA_MALWARE_SCAN_HOST=clamav
KASTA_MALWARE_SCAN_PORT=3310
KASTA_MALWARE_SCAN_TIMEOUT_SECONDS=10
KASTA_MALWARE_SCAN_FAIL_CLOSED=true
KASTA_FINANCIAL_RETENTION_DAYS=1825
KASTA_AUDIT_RETENTION_DAYS=2555
KASTA_SECURITY_DATA_RETENTION_DAYS=90

# Browser-visible values must never contain secrets.
PUBLIC_API_BASE_URL=http://localhost:8080/api/v1
PUBLIC_APP_ENVIRONMENT=local

# Image overrides. Pin immutable tags or digests in staging and production.
POSTGRES_IMAGE=postgres:17-alpine
MINIO_IMAGE=quay.io/minio/minio:latest
MINIO_MC_IMAGE=quay.io/minio/mc:latest
CADDY_IMAGE=caddy:2-alpine
CLAMAV_IMAGE=clamav/clamav:1.4
KASTA_MAIL_ENABLED=false
KASTA_SMTP_HOST=smtp.mx.cloudflare.net
KASTA_SMTP_PORT=465
KASTA_SMTP_USERNAME=
KASTA_SMTP_PASSWORD=
KASTA_SMTP_SSL=true
KASTA_SMTP_STARTTLS=false
KASTA_MAIL_FROM=KASTA <noreply@admniaga.com>
KASTA_MAIL_OUTBOX_POLL_SECONDS=2
KASTA_WHATSAPP_ENABLED=false
KASTA_WHATSAPP_API_BASE_URL=https://graph.facebook.com
KASTA_WHATSAPP_GRAPH_API_VERSION=v23.0
KASTA_WHATSAPP_PHONE_NUMBER_ID=
KASTA_WHATSAPP_ACCESS_TOKEN=
KASTA_WHATSAPP_TEMPLATE_NAME=kasta_verification
KASTA_WHATSAPP_TEMPLATE_LANGUAGE=id
