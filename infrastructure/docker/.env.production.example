# Copy to /opt/kasta/.env.production (outside the repository) and replace every
# REPLACE_* value using a secret manager or a protected deployment secret store.
# Never commit the copied file.

COMPOSE_PROJECT_NAME=kasta-production
KASTA_ENVIRONMENT=production
KASTA_IMAGE_TAG=2026.07.22

# Domains
KASTA_SITE_ADDRESS=https://appkasta.admniaga.com
PUBLIC_API_BASE_URL=https://apikasta.admniaga.com/api/v1
KASTA_OBJECT_PUBLIC_ENDPOINT=https://apikasta.admniaga.com
KASTA_CORS_ORIGINS=["https://kasta.admniaga.com","https://appkasta.admniaga.com"]
KASTA_TRUSTED_PROXY_CIDRS=["172.16.0.0/12"]

# PostgreSQL. Keep passwords URL-safe (or URL-encode them in the migration URL).
POSTGRES_IMAGE=postgres:17-alpine
POSTGRES_DB=kasta
POSTGRES_USER=kasta_owner
POSTGRES_PASSWORD=REPLACE_ME
KASTA_DB_APP_USER=kasta_app
KASTA_DB_APP_PASSWORD=REPLACE_ME
KASTA_MIGRATION_DATABASE_URL=postgresql+psycopg://kasta_owner:REPLACE_ME@postgres:5432/kasta

# MinIO. Use a long, unique value for both root and API object credentials.
MINIO_IMAGE=quay.io/minio/minio:REPLACE_WITH_PINNED_RELEASE
MINIO_MC_IMAGE=quay.io/minio/mc:REPLACE_WITH_PINNED_RELEASE
MINIO_ROOT_USER=REPLACE_ROOT
MINIO_ROOT_PASSWORD=REPLACE8
KASTA_OBJECT_ACCESS_KEY=REPLACE_APP
KASTA_OBJECT_SECRET_KEY=REPLACE_PW
KASTA_OBJECT_BUCKET_RECEIPTS=kasta-receipts
KASTA_OBJECT_BUCKET_BUSINESS_LOGOS=kasta-business-logos

# Application secrets. Generate with a cryptographically secure generator.
KASTA_JWT_ALGORITHM=HS256
KASTA_JWT_ISSUER=kasta-api
KASTA_JWT_AUDIENCE=kasta-clients
KASTA_JWT_SIGNING_KEY=REPLACE_ME
KASTA_TOKEN_HASH_KEY=REPLACE_ME
KASTA_OUTBOX_ENCRYPTION_KEY=REPLACE_ME

# Runtime tuning and policy
KASTA_LOG_LEVEL=INFO
KASTA_LOG_FORMAT=json
KASTA_DATABASE_POOL_SIZE=10
KASTA_DATABASE_MAX_OVERFLOW=20
KASTA_ACCESS_TOKEN_MINUTES=15
KASTA_REFRESH_TOKEN_DAYS=30
KASTA_SIGNED_URL_SECONDS=300
KASTA_MALWARE_SCAN_ENABLED=false
KASTA_FINANCIAL_RETENTION_DAYS=1825
KASTA_AUDIT_RETENTION_DAYS=2555
KASTA_SECURITY_DATA_RETENTION_DAYS=90

# Optional image overrides. Pin immutable digests in production.
CADDY_IMAGE=caddy:2.10-alpine
