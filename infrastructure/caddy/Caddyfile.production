# Caddy obtains and renews Let's Encrypt certificates automatically. DNS for
# every name below must point to this host and ports 80/443 must be reachable.
#
# kasta.admniaga.com serves the whole stack: website at the root, API under
# /api/*, and MinIO signed-object paths under the bucket prefixes.

(kasta-security) {
	encode zstd gzip
	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(self), microphone=(), geolocation=(), payment=()"
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		-Server
	}
}

(kasta-routes) {
	import kasta-security

	# API routes are kept distinct from private MinIO signed-object paths.
	@api path /api/* /docs* /redoc* /openapi.json
	handle @api {
		reverse_proxy api:8000
	}

	# Signed object URLs are path-style: /<bucket>/<object>. Only the two KASTA
	# buckets reach MinIO. Buckets stay private by listing; only short-lived
	# signed URLs generated by the API should be used.
	@objects path /{$KASTA_OBJECT_BUCKET_RECEIPTS:kasta-receipts}/* /{$KASTA_OBJECT_BUCKET_BUSINESS_LOGOS:kasta-business-logos}/*
	handle @objects {
		reverse_proxy minio:9000
	}

	# Everything else is the SvelteKit website.
	handle {
		reverse_proxy web:3000
	}
}

kasta.admniaga.com {
	import kasta-routes
}

# Deprecated hostname. Kept byte-for-byte as it was: the catch-all below
# forwards every non-API path to MinIO, so signed object URLs keep working
# whatever the bucket names are. Do not fold this into kasta-routes --
# that would only match the two configured bucket prefixes and 404 the rest.
apikasta.admniaga.com {
	import kasta-security

	@api path /api/* /docs* /redoc* /openapi.json
	handle @api {
		reverse_proxy api:8000
	}

	handle {
		reverse_proxy minio:9000
	}
}

appkasta.admniaga.com {
	redir https://kasta.admniaga.com{uri} permanent
}
